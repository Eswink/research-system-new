{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "status",
    "created_at",
    "summary",
    "severity",
    "source_refs",
    "occurrences",
    "problem",
    "proposal",
    "replay"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^LEARN-[0-9]{8}-[0-9]{3}$"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "CLUSTERED",
        "REPLAYING",
        "REVIEWING",
        "ACCEPTED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string",
      "minLength": 8
    },
    "severity": {
      "enum": [
        "NORMAL",
        "SECURITY_CRITICAL"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "occurrences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_ref",
          "evidence_ref"
        ],
        "properties": {
          "task_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "problem": {
      "type": "object",
      "required": [
        "observed_behavior",
        "expected_behavior",
        "reproduction"
      ],
      "properties": {
        "observed_behavior": {
          "type": "string",
          "minLength": 1
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 1
        },
        "reproduction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "proposal": {
      "type": "object",
      "required": [
        "target_type",
        "target_paths",
        "change_summary",
        "blast_radius"
      ],
      "properties": {
        "target_type": {
          "enum": [
            "RULE",
            "SKILL",
            "HOOK",
            "VALIDATOR",
            "EVAL",
            "KNOWLEDGE",
            "MEMORY",
            "ADR"
          ]
        },
        "target_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "change_summary": {
          "type": "string",
          "minLength": 1
        },
        "blast_radius": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "replay": {
      "type": "object",
      "required": [
        "before_cases",
        "after_cases"
      ],
      "properties": {
        "before_cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "after_cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "before_result": {
          "type": "string"
        },
        "after_result": {
          "type": "string"
        }
      }
    },
    "promotion": {
      "type": "object",
      "properties": {
        "promoted_at": {
          "type": "string"
        },
        "promoted_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "regression_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authorization_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reviewer",
          "ref",
          "hard_gate"
        ],
        "properties": {
          "reviewer": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "hard_gate": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          }
        }
      }
    }
  }
}
