{
  "plugins": {
    "enabledPlugins": {
      "mimosa@zcode-plugins-official": false
    }
  },
  "hooks": {
    "enabled": true,
    "timeoutMs": 15000,
    "events": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "process",
              "command": "python",
              "args": [
                "${ZCODE_PROJECT_DIR}/tools/zcode-hooks/skill_index_context.py"
              ],
              "timeoutMs": 10000,
              "statusMessage": "注入本仓技能索引"
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Read|Bash",
          "hooks": [
            {
              "type": "process",
              "command": "python",
              "args": [
                "${ZCODE_PROJECT_DIR}/tools/zcode-hooks/skill_invocation_guard.py"
              ],
              "timeoutMs": 10000,
              "statusMessage": "校验技能正文必须经 Skill 工具加载"
            }
          ]
        }
      ]
    }
  }
}
