{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/model-runtime-fingerprint.schema.json",
  "title": "ModelRuntimeFingerprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["endpoint_config_digest", "requested_model_id"],
  "properties": {
    "endpoint_config_digest": {
      "type": "string",
      "minLength": 1
    },
    "requested_model_id": {
      "type": "string",
      "minLength": 1
    },
    "returned_model_identifier": {
      "type": ["string", "null"]
    },
    "system_fingerprint": {
      "type": ["string", "null"]
    },
    "selected_response_metadata": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "probe_suite_digest": {
      "type": ["string", "null"]
    },
    "calibration_prompt_version": {
      "type": ["string", "null"]
    },
    "calibration_result_digest": {
      "type": ["string", "null"]
    },
    "observed_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "CHAT",
          "STREAMING",
          "TOOL_CALLING_NATIVE",
          "TOOL_CALLING_EMULATED",
          "STRUCTURED_OUTPUT_NATIVE",
          "STRUCTURED_OUTPUT_PROMPTED",
          "VISION",
          "REASONING",
          "EMBEDDING",
          "SEED",
          "USAGE_REPORTING",
          "SYSTEM_FINGERPRINT"
        ]
      }
    },
    "captured_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}