{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/protocol.schema.json",
  "title": "ProtocolDefinition",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "version",
    "phases"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "strategy"
        ]
      }
    }
  }
}
