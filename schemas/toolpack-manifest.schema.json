{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/toolpack-manifest.schema.json",
  "title": "ToolPackManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "source",
    "resolved_revision",
    "digest",
    "license",
    "tools",
    "skills",
    "requested_capabilities",
    "credentials",
    "compatibility"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "resolved_revision": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "minLength": 1},
    "signature": {"type": ["string", "null"]},
    "license": {"type": "string", "minLength": 1},
    "tools": {"$ref": "#/$defs/refs"},
    "skills": {"$ref": "#/$defs/refs"},
    "requested_capabilities": {"$ref": "#/$defs/refs"},
    "network_domains": {"$ref": "#/$defs/refs"},
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "scope"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "research_os": {"type": "string", "minLength": 1},
        "mcp_protocol": {"type": ["string", "null"]},
        "python": {"type": ["string", "null"]},
        "node": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}