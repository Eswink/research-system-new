{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/fallback-audit-record.schema.json",
  "title": "FallbackAuditRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["from_model", "to_model", "reason", "occurred_at"],
  "properties": {
    "from_model": {
      "type": "string",
      "minLength": 1
    },
    "to_model": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_ref": {
      "type": ["string", "null"]
    },
    "manifest_policy": {
      "type": ["string", "null"]
    },
    "session_switched": {
      "type": "boolean",
      "default": false
    }
  }
}