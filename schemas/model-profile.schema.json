{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/model-profile.schema.json",
  "title": "ModelProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "primary"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "primary": {"type": "string", "minLength": 1},
    "fallback": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "hard_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "CHAT",
          "STREAMING",
          "TOOL_CALLING_NATIVE",
          "TOOL_CALLING_EMULATED",
          "STRUCTURED_OUTPUT_NATIVE",
          "STRUCTURED_OUTPUT_PROMPTED",
          "VISION",
          "REASONING",
          "EMBEDDING",
          "SEED",
          "USAGE_REPORTING",
          "SYSTEM_FINGERPRINT"
        ]
      }
    }
  }
}