{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/audit_report_v1.schema.json",
  "title": "AuditReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_ref",
    "checks",
    "verdict"
  ],
  "properties": {
    "subject_ref": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "outcome"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
          "detail": { "type": "string" }
        }
      }
    },
    "verdict": { "type": "string", "enum": ["REPRODUCIBLE", "NOT_REPRODUCIBLE", "NOT_VERIFIED"] },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
