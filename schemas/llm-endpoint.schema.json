{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/llm-endpoint.schema.json",
  "title": "LLMEndpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "protocol",
    "base_url",
    "credential_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "enum": [
        "OPENAI_COMPATIBLE",
        "ANTHROPIC"
      ]
    },
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "credential_ref": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "request_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "concurrency_limit": {
      "type": "integer",
      "minimum": 1
    },
    "api_style": {
      "type": "string",
      "enum": [
        "chat_completions",
        "responses"
      ],
      "default": "chat_completions"
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "allow_models": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "circuit_breaker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failure_threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 5
        },
        "open_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "default": 60
        },
        "half_open_max_probes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 1
        }
      }
    }
  }
}
