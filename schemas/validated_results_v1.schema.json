{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/validated_results_v1.schema.json",
  "title": "ValidatedResultsV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_ref",
    "observations",
    "conclusions"
  ],
  "properties": {
    "experiment_ref": { "type": "string", "minLength": 1 },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "conclusions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": {}
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
