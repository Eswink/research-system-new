{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/tool-spec.schema.json",
  "title": "ToolSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "effect_class", "provider_kind", "capabilities"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "effect_class": {
      "enum": ["READ_ONLY", "WRITE", "EXECUTE", "NETWORK", "SECRET_USE", "DESTRUCTIVE", "EXTERNAL_PUBLISH"]
    },
    "provider_kind": {"enum": ["NATIVE", "MCP", "REST", "CLI", "REMOTE_WORKER"]},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}