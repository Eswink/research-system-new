{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/task-contract.schema.json",
  "title": "TaskContract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "version",
    "purpose",
    "acceptance_criteria"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1
    }
  }
}
