{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/handoff-bundle.schema.json",
  "title": "HandoffBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "producer", "summary", "digest"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "producer_agent_id": {"type": "string", "minLength": 1},
    "producer_role_id": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "structured_output": {},
    "artifact_refs": {"$ref": "#/$defs/refs"},
    "claim_refs": {"$ref": "#/$defs/refs"},
    "evidence_refs": {"$ref": "#/$defs/refs"},
    "decision_refs": {"$ref": "#/$defs/refs"},
    "open_questions": {"$ref": "#/$defs/textItems"},
    "known_failures": {"$ref": "#/$defs/textItems"},
    "recommended_next_actions": {"$ref": "#/$defs/textItems"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "textItems": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}