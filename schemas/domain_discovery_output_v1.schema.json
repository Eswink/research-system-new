{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/domain_discovery_output_v1.schema.json",
  "title": "DomainDiscoveryOutputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_map",
    "source_refs",
    "open_questions"
  ],
  "properties": {
    "domain_map": {
      "type": "object",
      "additionalProperties": {}
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
