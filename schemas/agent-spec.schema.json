{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/agent-spec.schema.json",
  "title": "AgentSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "role", "model_binding"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "model_binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {"enum": ["EXPLICIT_MODEL", "MODEL_PROFILE"]},
            "value": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"const": "INHERIT"}
          }
        }
      ]
    },
    "workspace_policy": {
      "enum": ["read_only", "notes_only", "isolated_writable", "deliverable_only"]
    }
  }
}