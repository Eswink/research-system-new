{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/preflight-report.schema.json",
  "title": "PreflightReport",
  "type": "object",
  "required": [
    "status",
    "findings"
  ],
  "properties": {
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "WARN"
      ]
    },
    "findings": {
      "type": "array"
    },
    "estimated_cost": {
      "type": [
        "number",
        "null"
      ]
    },
    "reserved_budget_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
