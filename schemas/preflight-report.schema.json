{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/preflight-report.schema.json",
  "title": "PreflightReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "findings", "unresolved_risks"],
  "properties": {
    "status": {"enum": ["PASS", "FAIL", "WARN"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"enum": ["ERROR", "WARNING", "INFO"]},
          "message": {"type": "string", "minLength": 1},
          "subject_ref": {"type": ["string", "null"]}
        }
      }
    },
    "estimated_cost": {"type": ["number", "null"], "minimum": 0},
    "reserved_budget_ref": {"type": ["string", "null"]},
    "unresolved_risks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}