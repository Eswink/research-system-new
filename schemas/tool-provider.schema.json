{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/tool-provider.schema.json",
  "title": "ToolProviderSpec",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "kind",
    "capabilities"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "NATIVE",
        "MCP",
        "REST",
        "CLI",
        "REMOTE_WORKER"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
