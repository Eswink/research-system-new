# Research OS personal-production environment template.
# Copy to .env (gitignored), replace every change-me value, and never commit it.
# POSIX:      cp .env.example .env
# PowerShell: Copy-Item .env.example .env
#
# This is an operator inventory, not a least-privilege process environment.
# The API, gateway, and worker must receive only their documented subsets;
# in particular, never expose PostgreSQL or LLM credentials to the worker.

# ── PostgreSQL / Compose ──────────────────────────────────────
RESEARCHOS_POSTGRES_PASSWORD=change-me-now
RESEARCHOS_POSTGRES_HOST_PORT=15432
RESEARCHOS_API_HOST_PORT=8000
RESEARCHOS_CONSOLE_HOST_PORT=5173
RESEARCHOS_IMAGE_TAG=local
RESEARCHOS_DATABASE_URL=postgresql://research_os:change-me-now@127.0.0.1:15432/research_os
RESEARCHOS_POSTGRES_DSN=postgresql://research_os:change-me-now@127.0.0.1:15432/research_os

# ── Worker gateway ────────────────────────────────────────────
WORKER_ENROLLMENT_SECRET=change-me-now-worker-enrollment
RESEARCHOS_WORKER_ENROLLMENT_SECRET=change-me-now-worker-enrollment
RESEARCHOS_WORKER_GATEWAY_HOST=127.0.0.1
RESEARCHOS_WORKER_GATEWAY_PORT=8081
RESEARCHOS_WORKER_GATEWAY_URL=http://127.0.0.1:8081
# Non-loopback binding requires TLS; 0 is valid only for loopback deployment.
RESEARCHOS_WORKER_GATEWAY_REQUIRE_TLS=0
RESEARCHOS_WORKER_PROTOCOL_VERSION=1

# ── Worker execution / GPU ────────────────────────────────────
RESEARCHOS_WORKER_ID=personal-w1
RESEARCHOS_WORKER_EXECUTION_BACKEND=docker
RESEARCHOS_WORKER_BACKEND_KINDS=DOCKER
RESEARCHOS_WORKER_CAPABILITIES=docker
RESEARCHOS_WORKER_DOCKER_IMAGE=research-os-gpu-sandbox@sha256:3d306d299abcb7c5384151ee15b6b7f5819e70203e5da50b47341710720c9d5c
RESEARCHOS_WORKER_GPU_IMAGE=research-os-gpu-sandbox@sha256:3d306d299abcb7c5384151ee15b6b7f5819e70203e5da50b47341710720c9d5c
# The production worker reads runtime_version from root VERSION by default.
# Override only for an explicitly qualified compatibility test.
# RESEARCHOS_WORKER_RUNTIME_VERSION=0.4.0
# Optional shared-host blob path; PostgreSQL credentials still stay out of worker.
# RESEARCHOS_WORKER_ARTIFACT_BLOB_DIR=./data/artifacts-blobs
RESEARCHOS_ARTIFACT_BLOB_DIR=./data/artifacts-blobs

# ── LLM relay ─────────────────────────────────────────────────
# Formal repository catalogs reference LLM_MAIN_KEY directly. DEV_LLM_API_KEY
# is not an alias for LLM_MAIN_KEY; set the key named by the selected endpoint's
# credential_ref. Keep both empty until a real relay is provisioned.
LLM_MAIN_KEY=
DEV_LLM_BASE_URL=
DEV_LLM_API_KEY=
DEV_LLM_MODEL=
RESEARCH_MCP_URL=

# ── Telemetry ─────────────────────────────────────────────────
RESEARCHOS_OTEL_ENABLED=false
RESEARCHOS_OTEL_HOST_PORT=4318
RESEARCHOS_OTEL_ENDPOINT=http://127.0.0.1:4318

# ── Runtime adapters / default-deny policy ────────────────────
AGENT_RUNTIME=openhands_native
OPENHANDS_AGENT_SERVER_URL=
OPENHANDS_WORKSPACE_MODE=docker
WORKFLOW_ENGINE=local
POLICY_ENGINE=native

ALLOW_HOST_SHELL=false
ALLOW_PUBLIC_NETWORK=false
ALLOW_PACKAGE_INSTALL=false
ALLOW_DOCKER_SOCKET=false
