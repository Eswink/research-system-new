DATABASE_URL=postgresql+psycopg://research_os:research_os@localhost:5432/research_os
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=research-os
S3_ACCESS_KEY_ID=research_os
S3_SECRET_ACCESS_KEY=change-me

# Product normally stores relay config through UI/DB + Secret Store.
DEV_LLM_BASE_URL=
DEV_LLM_API_KEY=
DEV_LLM_MODEL=

RESEARCH_MCP_URL=

# Telemetry is configured through RESEARCHOS_OTEL_* (services/api/settings.py):
# RESEARCHOS_OTEL_ENABLED / _ENDPOINT / _TIMEOUT / _SAMPLE_RATIO /
# _HEADER_CREDENTIAL_REF. Standard OTEL_* variables are deliberately NOT read:
# content capture does not exist as a runtime flag (ADR-0026 — the closed
# attribute vocabulary makes prompt/response structurally unrepresentable), and
# OTEL_RESOURCE_ATTRIBUTES / OTEL_EXPORTER_OTLP_HEADERS are blocked in
# adapters/otel/{resource,provider}.py so they cannot bypass that vocabulary.
RESEARCHOS_OTEL_ENABLED=false
RESEARCHOS_OTEL_ENDPOINT=http://127.0.0.1:4318
MLFLOW_TRACKING_URI=http://localhost:5000

AGENT_RUNTIME=openhands_native
OPENHANDS_AGENT_SERVER_URL=
OPENHANDS_WORKSPACE_MODE=docker

WORKFLOW_ENGINE=local
POLICY_ENGINE=native

ALLOW_HOST_SHELL=false
ALLOW_PUBLIC_NETWORK=false
ALLOW_PACKAGE_INSTALL=false
ALLOW_DOCKER_SOCKET=false
