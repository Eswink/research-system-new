# Research OS Python service image for API, Worker Gateway, and validation Worker.
# External stages are immutable OCI index digests recorded in UPSTREAM_COMPONENTS.yaml.
FROM ghcr.io/astral-sh/uv:0.11.18@sha256:78bc42400d77b0678ba95765305c826652ed5431f399257271dda681d0318f03 AS uv
FROM python:3.12-slim@sha256:dd29372629eeba2dd003fd9e9d35a5b8236c44727875a0364254b5127af88e65 AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /app
COPY --from=uv /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

FROM python:3.12-slim@sha256:dd29372629eeba2dd003fd9e9d35a5b8236c44727875a0364254b5127af88e65 AS runtime

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1

RUN groupadd --system --gid 10001 researchos \
    && useradd --system --uid 10001 --gid researchos --home-dir /app researchos \
    && mkdir -p /var/lib/research-os/artifacts /var/lib/research-os/control \
    && chown -R researchos:researchos /var/lib/research-os

WORKDIR /app
COPY --from=builder --chown=researchos:researchos /app/.venv /app/.venv
COPY --chown=researchos:researchos VERSION UPSTREAM_COMPONENTS.yaml ./
COPY --chown=researchos:researchos adapters ./adapters
COPY --chown=researchos:researchos examples ./examples
COPY --chown=researchos:researchos infra/docker/research/loopback_proxy.py ./infra/docker/research/loopback_proxy.py
COPY --chown=researchos:researchos packages ./packages
COPY --chown=researchos:researchos schemas ./schemas
COPY --chown=researchos:researchos services ./services

USER researchos
ENTRYPOINT ["python", "-B"]
CMD ["-m", "uvicorn", "--factory", "services.api.app:create_app", "--host", "0.0.0.0", "--port", "8000"]
