{
  "name": "@research-os/web",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "node --import ./tests/helpers/registerStyles.mjs --import tsx --test tests/unit/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwrightLive.config.ts"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.1.0",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "yaml": "2.8.3"
  }
}